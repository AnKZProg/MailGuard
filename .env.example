# Clé de chiffrement des tokens OAuth (AES-256-GCM), 32 octets en base64.
# Génère la tienne avec : openssl rand -base64 32
MAILGUARD_ENCRYPTION_KEY=

# URL de l'app (ne change pas en usage local)
APP_URL=http://127.0.0.1:3000

# Google Cloud Console > API et services > Identifiants > ID client OAuth
# Type "Application Web", origine autorisée http://127.0.0.1:3000,
# URI de redirection http://127.0.0.1:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure/Entra ID > Inscriptions d'applications > (voir docs/setup-azure.md)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# SQLite local, ne pas changer sauf besoin spécifique
DATABASE_URL=file:./data/mailguard.db
